{
  "manifest_version": 3,
  "name": "Video Saver — Click to Download",
  "version": "4.0.8",
  "description": "Download detected course and social video streams as MP4 using a local FFmpeg helper.",
  "permissions": [
    "webRequest",
    "storage",
    "nativeMessaging",
    "scripting"
  ],
  "host_permissions": [
    "https://*.apnacollege.in/*",
    "https://*.wistia.com/*",
    "https://*.wistia.net/*",
    "https://*.udemy.com/*",
    "https://*.udemycdn.com/*",
    "https://*.cloudfront.net/*",
    "https://*.instagram.com/*",
    "https://*.cdninstagram.com/*",
    "https://*.facebook.com/*",
    "https://*.fbcdn.net/*",
    "https://*.tiktok.com/*",
    "https://*.tiktokcdn.com/*",
    "https://*.tiktokv.com/*",
    "https://*.byteoversea.com/*",
    "https://*.ibytedtos.com/*"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Video Saver"
  },
  "key": "",
  "content_scripts": [
    {
      "matches": [
        "https://*.apnacollege.in/*",
        "https://*.udemy.com/course/*/learn/*",
        "https://*.instagram.com/*",
        "https://*.facebook.com/*",
        "https://*.tiktok.com/*"
      ],
      "js": [
        "active-title.js",
        "lesson-title.js",
        "social-active-video.js"
      ],
      "run_at": "document_idle",
      "all_frames": false,
      "world": "ISOLATED"
    }
  ]
}
